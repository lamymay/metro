<?xml version="1.0" encoding="utf-8"?>
<!-- A tile. Drawn as shapes rather than shipped as PNGs so the app has no binary
     assets at all, and so it still renders on API 16 (VectorDrawable is 21+). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/metro_accent" />
        </shape>
    </item>
    <item
        android:bottom="24dp"
        android:left="10dp"
        android:right="24dp"
        android:top="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="10dp"
        android:left="26dp"
        android:right="10dp"
        android:top="26dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
